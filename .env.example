# Copie para `.env` (que NÃO vai para o Git) e ajuste. Nunca coloque segredos reais neste arquivo de exemplo.
# Carregue com:  set -a; . ./.env; set +a    (ou exporte as variáveis no painel do Render)

# --- obrigatório em produção -------------------------------------------------------------
OMNILINK_ENV=development                 # development | production | test
OMNILINK_ENROLLMENT_KEY=troque-por-um-segredo-longo-e-aleatorio   # >= 16 caracteres em produção

# --- persistência (opcional) -------------------------------------------------------------
# Vazio = memória (tudo se perde ao reiniciar). Exemplos:
#   sqlite:///omnilink.db                          (desenvolvimento local)
#   postgresql://usuario:senha@host:5432/banco     (Render injeta DATABASE_URL automaticamente com render.yaml)
OMNILINK_DATABASE_URL=

# --- rede/segurança ----------------------------------------------------------------------
# OMNILINK_REQUIRE_HTTPS=true            # padrão: true em produção, false em desenvolvimento
# OMNILINK_TRUST_PROXY=true              # padrão: true quando RENDER=true (confia em X-Forwarded-*)

# --- limites (valores padrão) ------------------------------------------------------------
# OMNILINK_MAX_REQUEST_BYTES=4000000
# OMNILINK_MAX_TEXT_CHARS=20000
# OMNILINK_MAX_HTML_BYTES=200000
# OMNILINK_MAX_IMAGE_BYTES=2000000
# OMNILINK_MAX_IMAGE_PIXELS=8000000
# OMNILINK_RATE_LIMIT_PER_MINUTE=60          # envios por dispositivo
# OMNILINK_CONTROL_RATE_LIMIT_PER_MINUTE=600 # demais chamadas autenticadas por dispositivo
# OMNILINK_IP_RATE_LIMIT_PER_MINUTE=20       # registros e falhas de autenticação por IP
# OMNILINK_MAX_DEVICES=50
# OMNILINK_QUEUE_TTL_SECONDS=3600            # tempo máximo de uma mensagem na fila
# OMNILINK_QUEUE_MAX_PER_DEVICE=100
# OMNILINK_STATUS_RETENTION_SECONDS=86400    # por quanto tempo o status (sem conteúdo) fica consultável
# OMNILINK_LONGPOLL_MAX_WAIT=25
# OMNILINK_SSE_MAX_SECONDS=120
# OMNILINK_TOKEN_TTL_DAYS=90                 # 0 = tokens sem expiração

# --- logs --------------------------------------------------------------------------------
# OMNILINK_LOG_LEVEL=INFO
# OMNILINK_LOG_JSON=true                     # padrão: true em produção

# --- usados pelos clientes (CLI) -------------------------------------------------------------
# OMNILINK_SERVER_URL=http://127.0.0.1:8000
# OMNILINK_CREDENTIALS=~/.omnilink/default.json
